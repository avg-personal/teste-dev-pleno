generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Modelo de Usuário para Autenticação
model User {
  id         Int         @id @default(autoincrement())
  name       String
  email      String      @unique
  password   String
  operations Operation[]
  createdAt  DateTime    @default(now())
}

// Modelo de Operação (Compra ou Venda)
model Operation {
  id        Int           @id @default(autoincrement())
  type      OperationType
  product   ProductType
  date      DateTime
  quantity  Float
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())
}

enum OperationType {
  BUY
  SELL
}

enum ProductType {
  GASOLINE
  ETHANOL
  DIESEL
}